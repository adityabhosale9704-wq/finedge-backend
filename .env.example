# Copy to .env at the project root; replace placeholders before use.
SECRET_KEY=replace-with-a-long-random-private-signing-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=hr_os_development
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Optional absolute paths. Omit to keep existing root db.sqlite3 and media/.
# SQLITE_PATH=C:/path/to/private/db.sqlite3
# MEDIA_ROOT=C:/path/to/private/media

# Optional integration-test server, separate from the application's MONGO_URI.
# HRMS_TEST_MONGO_URI=mongodb://127.0.0.1:27017
